# Copy to .env next to docker-compose.yml

# Image version: "latest" follows the newest push, a commit id such as 1a2b3c4 pins or rolls back
TAG=latest

# Public site address, used for canonical URLs, the sitemap and the Google Merchant feed
SITE_URL=https://thepackhouse.vn

# First admin login, only used while no admin exists. Password: at least 12 characters
ADMIN_EMAIL=admin@thepackhouse.vn
ADMIN_PASSWORD=change-me

# Host ports for the storefront
WEB_PORT=80
WEB_TLS_PORT=443
