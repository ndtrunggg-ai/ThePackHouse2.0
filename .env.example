# Copy to .env and replace every change-me with: openssl rand -base64 32
APP_KEYS=change-me,change-me,change-me,change-me
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me
JWT_SECRET=change-me

# Public site address, used for canonical URLs and feed links
SITE_URL=https://thepackhouse.vn
# Host port for the storefront
WEB_PORT=80
